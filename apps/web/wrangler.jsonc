{
  "name": "gparty",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/app.js", "**/*.css"],
      "fallthrough": true
    }
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "REPLACE_WITH_YOUR_R2_BUCKET_NAME"
    }
  ]
}
