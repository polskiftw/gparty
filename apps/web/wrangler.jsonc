{
  "name": "gparty",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/app.js", "**/chaos.js", "**/*.css", "**/*.svg"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.mid"],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [{"name": "VISITOR_COUNTER", "class_name": "VisitorCounter"}]
  },
  "migrations": [
    {"tag": "gparty-visitor-counter-v1", "new_sqlite_classes": ["VisitorCounter"]}
  ],
  "limits": {
    "cpu_ms": 300000
  },
  "r2_buckets": [
    {
      "binding": "PRIVATE_FILES_BUCKET",
      "bucket_name": "gparty-private-files-local"
    }
  ]
}
